
# Environment Variables Template for learn-winning.iiskills.cloud

# Supabase Configuration (Primary Authentication & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Deployment Configuration
NEXT_PUBLIC_SITE_URL=https://learn-winning.iiskills.cloud
NEXT_PUBLIC_API_URL=https://learn-winning.iiskills.cloud/api

# Payment Gateway
NEXT_PUBLIC_PAYMENT_URL=https://aienter.in/payments

# Email Configuration (for sending access codes)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@iiskill.in
SMTP_PASSWORD=your_smtp_password

# Application Settings
NEXT_PUBLIC_APP_NAME="Live Like a Winner"
NEXT_PUBLIC_COURSE_PRICE=99
NEXT_PUBLIC_CURRENCY=INR

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin Settings
ADMIN_PASSWORD=change_this_in_production

# Environment
NODE_ENV=production
